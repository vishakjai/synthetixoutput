    {
      "id": "android-architecture-mvvm",
      "name": "Android Architecture: MVVM + Unidirectional State Flow",
      "engineering_actions": [
        "Keep UI state in a ViewModel exposed as StateFlow or Compose State.",
        "Treat ViewModel as the single source of truth for screen-level state.",
        "Emit one-shot side effects via a Channel / SharedFlow, not LiveData."
      ]
    },
    {
      "id": "android-compose-first",
      "name": "Jetpack Compose-First UI",
      "engineering_actions": [
        "New screens must be Composable functions; legacy XML layouts are interop bridges only.",
        "Preview every screen with `@Preview` variants for light / dark / RTL.",
        "Use Material 3 components unless an explicit design-system override exists."
      ]
    },
    {
      "id": "android-offline-first",
      "name": "Offline-First Data Policy",
      "engineering_actions": [
        "Reads must resolve from local cache first; network refresh is async.",
        "Mutations enqueue to WorkManager or an equivalent persistent queue.",
        "Conflict resolution is explicit (last-writer-wins or merge), never silent."
      ]
    },
    {
      "id": "android-security-baseline",
      "name": "Mobile Security Baseline",
      "engineering_actions": [
        "Secrets at rest go through Android Keystore, never SharedPreferences.",
        "Network calls to private APIs must use certificate pinning.",
        "Release builds must enable R8 / ProGuard with keep rules for reflection points."
      ]
    }
  ],
