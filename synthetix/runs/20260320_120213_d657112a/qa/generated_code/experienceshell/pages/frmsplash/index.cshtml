@page "/ui/frmsplash"
@model ExperienceShell.Pages.FrmSplash.IndexModel
@{
    ViewData["Title"] = "Application startup and splash workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Application startup and splash workflow">
    <h1>Application startup and splash workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmSplash</code>.</p>
    <form method="post">
        <div class="ui-scaffold-field">
            <label for="progressbar">Progress Bar</label>
            <input id="progressbar" name="progressbar" value="@Model.State.GetValueOrDefault("progressbar", string.Empty)" />
            @if (Model.Errors.ContainsKey("progressbar"))
            {
                <span data-error-for="progressbar">@Model.Errors["progressbar"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="progressbar1">Progress Bar1</label>
