@page "/ui/frmsettings"
@model CustomerService.Pages.Frmsettings.IndexModel
@{
    ViewData["Title"] = "Account type maintenance and account setup workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Account type maintenance and account setup workflow">
    <h1>Account type maintenance and account setup workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmsettings</code>.</p>
    <form method="post">
        <div class="ui-scaffold-field">
            <label for="frasettings">Frasettings</label>
            <input id="frasettings" name="frasettings" value="@Model.State.GetValueOrDefault("frasettings", string.Empty)" />
            @if (Model.Errors.ContainsKey("frasettings"))
            {
                <span data-error-for="frasettings">@Model.Errors["frasettings"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="label1">Label1</label>
            <input id="label1" name="label1" value="@Model.State.GetValueOrDefault("label1", string.Empty)" />
            @if (Model.Errors.ContainsKey("label1"))
            {
                <span data-error-for="label1">@Model.Errors["label1"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="lblfieldlabel">Lbl Field Label</label>
            <input id="lblfieldlabel" name="lblfieldlabel" value="@Model.State.GetValueOrDefault("lblfieldlabel", string.Empty)" />
            @if (Model.Errors.ContainsKey("lblfieldlabel"))
            {
                <span data-error-for="lblfieldlabel">@Model.Errors["lblfieldlabel"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="lblaccountid">Lblaccountid</label>
            <input id="lblaccountid" name="lblaccountid" value="@Model.State.GetValueOrDefault("lblaccountid", string.Empty)" />
            @if (Model.Errors.ContainsKey("lblaccountid"))
            {
                <span data-error-for="lblaccountid">@Model.Errors["lblaccountid"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="txtaccountid">Txtaccountid</label>
            <input id="txtaccountid" name="txtaccountid" value="@Model.State.GetValueOrDefault("txtaccountid", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtaccountid"))
            {
                <span data-error-for="txtaccountid">@Model.Errors["txtaccountid"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="txtaccounttype">Txtaccounttype</label>
            <input id="txtaccounttype" name="txtaccounttype" value="@Model.State.GetValueOrDefault("txtaccounttype", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtaccounttype"))
            {
                <span data-error-for="txtaccounttype">@Model.Errors["txtaccounttype"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="txtcheque">Txtcheque</label>
            <input id="txtcheque" name="txtcheque" value="@Model.State.GetValueOrDefault("txtcheque", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtcheque"))
            {
                <span data-error-for="txtcheque">@Model.Errors["txtcheque"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="txtinterestrate">Txtinterestrate</label>
            <input id="txtinterestrate" name="txtinterestrate" value="@Model.State.GetValueOrDefault("txtinterestrate", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtinterestrate"))
            {
                <span data-error-for="txtinterestrate">@Model.Errors["txtinterestrate"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="txtnocheque">Txtnocheque</label>
            <input id="txtnocheque" name="txtnocheque" value="@Model.State.GetValueOrDefault("txtnocheque", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtnocheque"))
            {
                <span data-error-for="txtnocheque">@Model.Errors["txtnocheque"]</span>
            }
        </div>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtCancel">Cancel</button>
        <button type="submit" formaction="?handler=EvtSave">Save</button>
        </div>
    </form>
</main>
