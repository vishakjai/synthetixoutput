@page "/ui/frmdaily"
@model ReportingService.Pages.Frmdaily.IndexModel
@{
    ViewData["Title"] = "Business workflow executed through event-driven UI controls";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Business workflow executed through event-driven UI controls">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmdaily</p>
        <h1>Business workflow executed through event-driven UI controls</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmdaily</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="txtdaily">
        <label for="txtdaily">Da Ily</label>
        <input type="text" id="txtdaily" name="txtdaily" placeholder="Optional da ily" value="@Model.State.GetValueOrDefault("txtdaily", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtdaily"))
            {
                <span data-error-for="txtdaily">@Model.Errors["txtdaily"]</span>
            }
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="fradaily">
            <legend>Da Ily</legend>
        </fieldset>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
