@page "/ui/frmreport"
@model ReportingService.Pages.Frmreport.IndexModel
@{
    ViewData["Title"] = "Operational reporting and statement generation workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Operational reporting and statement generation workflow">
    <h1>Operational reporting and statement generation workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmreport</code>.</p>
    

    <form method="post">
        <div class="ui-scaffold-field" data-field-id="dtpfromdate">
            <label for="dtpfromdate">From Date</label>
            <input type="date" id="dtpfromdate" name="dtpfromdate" placeholder="Optional from date" value="@Model.State.GetValueOrDefault("dtpfromdate", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpfromdate"))
            {
                <span data-error-for="dtpfromdate">@Model.Errors["dtpfromdate"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="dtptodate">
            <label for="dtptodate">To Date</label>
            <input type="date" id="dtptodate" name="dtptodate" placeholder="Optional to date" value="@Model.State.GetValueOrDefault("dtptodate", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtptodate"))
            {
                <span data-error-for="dtptodate">@Model.Errors["dtptodate"]</span>
            }
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="frame3">
            <legend>Group 3</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame4">
            <legend>Group 4</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame5">
            <legend>Group 5</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame7">
            <legend>Group 7</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frareport">
            <legend>Report</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frasearch">
            <legend>Search</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label1">
            <label for="label1">Label 1</label>
            <output id="label1" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label1", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label2">
            <label for="label2">Label 2</label>
            <output id="label2" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label2", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label5">
            <label for="label5">Label 5</label>
            <output id="label5" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label5", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label6">
            <label for="label6">Label 6</label>
            <output id="label6" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label6", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label7">
            <label for="label7">Label 7</label>
            <output id="label7" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label7", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label8">
            <label for="label8">Label 8</label>
            <output id="label8" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label8", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomerid">
            <label for="lblcustomerid">Customer Id</label>
            <output id="lblcustomerid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomerid", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtbalance">
            <label for="txtbalance">Balance</label>
            <input type="number" id="txtbalance" name="txtbalance" placeholder="Optional balance" value="@Model.State.GetValueOrDefault("txtbalance", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtbalance"))
            {
                <span data-error-for="txtbalance">@Model.Errors["txtbalance"]</span>
            }
            <p class="ui-scaffold-hint">Txt Balance must be numeric.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtfirstname">
            <label for="txtfirstname">First Name</label>
            <input type="text" id="txtfirstname" name="txtfirstname" placeholder="Enter first name" value="@Model.State.GetValueOrDefault("txtfirstname", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtfirstname"))
            {
                <span data-error-for="txtfirstname">@Model.Errors["txtfirstname"]</span>
            }
            <p class="ui-scaffold-hint">Txt First Name is required.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtlastname">
            <label for="txtlastname">Last Name</label>
            <input type="text" id="txtlastname" name="txtlastname" placeholder="Enter last name" value="@Model.State.GetValueOrDefault("txtlastname", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtlastname"))
            {
                <span data-error-for="txtlastname">@Model.Errors["txtlastname"]</span>
            }
            <p class="ui-scaffold-hint">Txt Last Name is required.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtaccount">
            <label for="txtaccount">Account</label>
            <input type="number" id="txtaccount" name="txtaccount" placeholder="Enter account" value="@Model.State.GetValueOrDefault("txtaccount", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtaccount"))
            {
                <span data-error-for="txtaccount">@Model.Errors["txtaccount"]</span>
            }
            <p class="ui-scaffold-hint">Txtaccount is required.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtaccountno">
            <label for="txtaccountno">Account No</label>
            <input type="number" id="txtaccountno" name="txtaccountno" placeholder="Enter account no" value="@Model.State.GetValueOrDefault("txtaccountno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtaccountno"))
            {
                <span data-error-for="txtaccountno">@Model.Errors["txtaccountno"]</span>
            }
            <p class="ui-scaffold-hint">Txtaccountno is required.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtcustomerid">
            <label for="txtcustomerid">Customer Id</label>
            <input type="number" id="txtcustomerid" name="txtcustomerid" placeholder="Enter customer id" value="@Model.State.GetValueOrDefault("txtcustomerid", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtcustomerid"))
            {
                <span data-error-for="txtcustomerid">@Model.Errors["txtcustomerid"]</span>
            }
            <p class="ui-scaffold-hint">Txtcustomerid is required.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txttypeofaccount">
            <label for="txttypeofaccount">Type Of Account</label>
            <input type="number" id="txttypeofaccount" name="txttypeofaccount" placeholder="Enter type of account" value="@Model.State.GetValueOrDefault("txttypeofaccount", string.Empty)" />
            @if (Model.Errors.ContainsKey("txttypeofaccount"))
            {
                <span data-error-for="txttypeofaccount">@Model.Errors["txttypeofaccount"]</span>
            }
            <p class="ui-scaffold-hint">Txttypeofaccount is required.</p>
        </div>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtCancel">Cancel</button>
        </div>
    </form>
</main>
