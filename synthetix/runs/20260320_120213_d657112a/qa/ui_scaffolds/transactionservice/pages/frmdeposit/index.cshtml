@page "/ui/frmdeposit"
@model TransactionService.Pages.Frmdeposit.IndexModel
@{
    ViewData["Title"] = "Deposit capture and balance posting workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Deposit capture and balance posting workflow">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmdeposit</p>
        <h1>Deposit capture and balance posting workflow</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmdeposit</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="txtdateoftransaction">
        <label for="txtdateoftransaction">Date Of Transaction</label>
        <input type="date" id="txtdateoftransaction" name="txtdateoftransaction" placeholder="Optional date of transaction" value="@Model.State.GetValueOrDefault("txtdateoftransaction", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtdateoftransaction"))
            {
                <span data-error-for="txtdateoftransaction">@Model.Errors["txtdateoftransaction"]</span>
            }
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="fracheque">
            <legend>Cheque</legend>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="fraext">
            <legend>Ext</legend>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="framode">
            <legend>Mode</legend>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblaccount">
            <label for="lblaccount">Account</label>
            <output id="lblaccount" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblaccount", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbalance">
            <label for="lblbalance">Balance</label>
            <output id="lblbalance" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbalance", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbankname">
            <label for="lblbankname">Bank Name</label>
            <output id="lblbankname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbankname", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblchequeissued">
            <label for="lblchequeissued">Cheque Issued</label>
            <output id="lblchequeissued" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblchequeissued", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomer">
            <label for="lblcustomer">Customer</label>
            <output id="lblcustomer" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomer", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomerid">
            <label for="lblcustomerid">Customer ID</label>
            <output id="lblcustomerid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomerid", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbldate">
            <label for="lbldate">Date</label>
            <output id="lbldate" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbldate", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfirstname">
            <label for="lblfirstname">First Name</label>
            <output id="lblfirstname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfirstname", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllastname">
            <label for="lbllastname">Last Name</label>
            <output id="lbllastname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllastname", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbltypeofaccount">
            <label for="lbltypeofaccount">Type Of Account</label>
            <output id="lbltypeofaccount" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbltypeofaccount", "—")</output>
        </div>
        <fieldset class="ui-scaffold-choice" data-radio-group="paymentmode">
            <legend>Payment Mode</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optcash" name="paymentmode" value="Cash" />
                <span>Cash</span>
            </label>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optcheque" name="paymentmode" value="Cheque" />
                <span>Cheque</span>
            </label>
        </fieldset>
        <fieldset class="ui-scaffold-choice" data-radio-group="yesno">
            <legend>Yes Or No</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optno" name="yesno" value="No" />
                <span>No</span>
            </label>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optyes" name="yesno" value="Yes" />
                <span>Yes</span>
            </label>
        </fieldset>
        <div class="ui-scaffold-field" data-field-id="txtbankname">
        <label for="txtbankname">Bank Name</label>
        <input type="text" id="txtbankname" name="txtbankname" placeholder="Enter bank name" value="@Model.State.GetValueOrDefault("txtbankname", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtbankname"))
            {
                <span data-error-for="txtbankname">@Model.Errors["txtbankname"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txtchequeno">
        <label for="txtchequeno">Cheque No</label>
        <input type="text" id="txtchequeno" name="txtchequeno" placeholder="Optional cheque no" value="@Model.State.GetValueOrDefault("txtchequeno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtchequeno"))
            {
                <span data-error-for="txtchequeno">@Model.Errors["txtchequeno"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txtsearchaccountno">
        <label for="txtsearchaccountno">Search Account No</label>
        <input type="number" id="txtsearchaccountno" name="txtsearchaccountno" placeholder="Enter search account no" value="@Model.State.GetValueOrDefault("txtsearchaccountno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtsearchaccountno"))
            {
                <span data-error-for="txtsearchaccountno">@Model.Errors["txtsearchaccountno"]</span>
            }
            <p class="ui-scaffold-hint">Enter digits only.</p>
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-primary" type="submit" formaction="?handler=EvtSave"><span>Save</span><small>POST /transactions/deposit, list</small></button>
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
