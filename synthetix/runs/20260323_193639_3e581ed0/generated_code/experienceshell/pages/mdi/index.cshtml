@page "/ui/mdi"
@model ExperienceShell.Pages.Mdi.IndexModel
@{
    ViewData["Title"] = "Application navigation and module routing workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Application navigation and module routing workflow">
    <header class="screen-header">
        <p class="meta-chip">Contract: Mdi</p>
        <h1>Application navigation and module routing workflow</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>Mdi</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-nav-item" data-field-id="mnudepositamount">
            <a class="ui-scaffold-nav-link" href="/ui/frmdeposit">Deposit Amount</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnuexit">
            <a class="ui-scaffold-nav-link" href="/">Exit</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnureports">
            <a class="ui-scaffold-nav-link" href="/ui/reports">Reports</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnuwithdrawamount">
            <a class="ui-scaffold-nav-link" href="/ui/frmwithdraw">Withdraw Amount</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnuaddinterest">
            <a class="ui-scaffold-nav-link" href="/ui/addinterest">Add Interest</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnuclose">
            <a class="ui-scaffold-nav-link" href="/">Close</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnucustomerdetails">
            <a class="ui-scaffold-nav-link" href="/ui/frmcustomer">Customer Details</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnuinterest">
            <a class="ui-scaffold-nav-link" href="/ui/addinterest">Interest</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnumaster">
            <a class="ui-scaffold-nav-link" href="#">Mas Ter</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnumonthly">
            <a class="ui-scaffold-nav-link" href="#">Monthly</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnustatement">
            <a class="ui-scaffold-nav-link" href="#">Statement</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnutransaction">
            <a class="ui-scaffold-nav-link" href="/ui/frmdeposit">Transaction</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnutransactions">
            <a class="ui-scaffold-nav-link" href="/ui/frmdeposit">Transactions</a>
        </div>
        <div class="ui-scaffold-nav-item" data-field-id="mnuviewtransaction">
            <a class="ui-scaffold-nav-link" href="/ui/frmdeposit">View Transaction</a>
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtSearch"><span>Search</span><small>GET /experienceshell/splash</small></button>
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
