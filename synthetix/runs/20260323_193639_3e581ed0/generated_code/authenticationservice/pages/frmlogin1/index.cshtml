@page "/ui/frmlogin1"
@model AuthenticationService.Pages.FrmLogin1.IndexModel
@{
    ViewData["Title"] = "Authentication and credential validation workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Authentication and credential validation workflow">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmLogin1</p>
        <h1>Authentication and credential validation workflow</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmLogin1</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllabels">
            <label for="lbllabels">S</label>
            <output id="lbllabels" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllabels", "—")</output>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtpass">
        <label for="txtpass">Pass</label>
        <input type="password" id="txtpass" name="txtpass" placeholder="Optional pass" value="@Model.State.GetValueOrDefault("txtpass", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtpass"))
            {
                <span data-error-for="txtpass">@Model.Errors["txtpass"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txtun">
        <label for="txtun">Un</label>
        <input type="text" id="txtun" name="txtun" placeholder="Optional un" value="@Model.State.GetValueOrDefault("txtun", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtun"))
            {
                <span data-error-for="txtun">@Model.Errors["txtun"]</span>
            }
            
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-primary" type="submit" formaction="?handler=EvtSave"><span>Save</span><small>POST /auth/login, list</small></button>
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
