@page "/ui/frmaddinterest"
@model LegacyCoreService.Pages.Frmaddinterest.IndexModel
@{
    ViewData["Title"] = "Interest calculation and posting workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Interest calculation and posting workflow">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmaddinterest</p>
        <h1>Interest calculation and posting workflow</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmaddinterest</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="txtdate">
        <label for="txtdate">Date</label>
        <input type="date" id="txtdate" name="txtdate" placeholder="Optional date" value="@Model.State.GetValueOrDefault("txtdate", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtdate"))
            {
                <span data-error-for="txtdate">@Model.Errors["txtdate"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="cbomonth">
            <label for="cbomonth">Mo Nth</label>
            <select id="cbomonth" name="cbomonth">
                <option value="Select an option">Select an option</option>
            </select>
            
        </div>
        <div class="ui-scaffold-field" data-field-id="cboyear">
            <label for="cboyear">Y Ear</label>
            <select id="cboyear" name="cboyear">
                <option value="Select an option">Select an option</option>
            </select>
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="fra">
            <legend>Screen</legend>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblamount">
            <label for="lblamount">Amo Unt</label>
            <output id="lblamount" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblamount", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbal">
            <label for="lblbal">Bal</label>
            <output id="lblbal" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbal", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbalance">
            <label for="lblbalance">Balance</label>
            <output id="lblbalance" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbalance", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcurrentbalance">
            <label for="lblcurrentbalance">Cur Ren T Balance</label>
            <output id="lblcurrentbalance" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcurrentbalance", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomerid">
            <label for="lblcustomerid">Customer ID</label>
            <output id="lblcustomerid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomerid", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfirstname">
            <label for="lblfirstname">First Name</label>
            <output id="lblfirstname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfirstname", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblid">
            <label for="lblid">ID</label>
            <output id="lblid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblid", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblinterest">
            <label for="lblinterest">Interest</label>
            <output id="lblinterest" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblinterest", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllastname">
            <label for="lbllastname">Last Name</label>
            <output id="lbllastname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllastname", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbltransaction">
            <label for="lbltransaction">Transaction</label>
            <output id="lbltransaction" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbltransaction", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbltransactionid">
            <label for="lbltransactionid">Transaction ID</label>
            <output id="lbltransactionid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbltransactionid", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbltype">
            <label for="lbltype">Type</label>
            <output id="lbltype" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbltype", "—")</output>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtaccountno">
        <label for="txtaccountno">Account No</label>
        <input type="number" id="txtaccountno" name="txtaccountno" placeholder="Enter account no" value="@Model.State.GetValueOrDefault("txtaccountno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtaccountno"))
            {
                <span data-error-for="txtaccountno">@Model.Errors["txtaccountno"]</span>
            }
            <p class="ui-scaffold-hint">Enter digits only.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtcurrentdate">
        <label for="txtcurrentdate">Cur Ren T Date</label>
        <input type="date" id="txtcurrentdate" name="txtcurrentdate" placeholder="Optional cur ren t date" value="@Model.State.GetValueOrDefault("txtcurrentdate", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtcurrentdate"))
            {
                <span data-error-for="txtcurrentdate">@Model.Errors["txtcurrentdate"]</span>
            }
            
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
