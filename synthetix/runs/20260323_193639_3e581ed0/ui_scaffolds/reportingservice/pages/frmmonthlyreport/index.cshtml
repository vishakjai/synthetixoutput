@page "/ui/frmmonthlyreport"
@model ReportingService.Pages.Frmmonthlyreport.IndexModel
@{
    ViewData["Title"] = "Operational reporting and statement generation workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Operational reporting and statement generation workflow">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmmonthlyreport</p>
        <h1>Operational reporting and statement generation workflow</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmmonthlyreport</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="dtpfrom">
        <label for="dtpfrom">From</label>
        <input type="text" id="dtpfrom" name="dtpfrom" placeholder="Optional from" value="@Model.State.GetValueOrDefault("dtpfrom", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpfrom"))
            {
                <span data-error-for="dtpfrom">@Model.Errors["dtpfrom"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="dtpto">
        <label for="dtpto">To</label>
        <input type="text" id="dtpto" name="dtpto" placeholder="Optional to" value="@Model.State.GetValueOrDefault("dtpto", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpto"))
            {
                <span data-error-for="dtpto">@Model.Errors["dtpto"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="cmbcustomerid">
            <label for="cmbcustomerid">Customer ID</label>
            <select id="cmbcustomerid" name="cmbcustomerid">
                <option value="Select an option">Select an option</option>
            </select>
            
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfrom">
            <label for="lblfrom">From</label>
            <output id="lblfrom" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfrom", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblto">
            <label for="lblto">To</label>
            <output id="lblto" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblto", "—")</output>
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
