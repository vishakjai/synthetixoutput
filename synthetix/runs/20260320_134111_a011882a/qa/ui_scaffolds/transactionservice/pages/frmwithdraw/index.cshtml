@page "/ui/frmwithdraw"
@model TransactionService.Pages.Frmwithdraw.IndexModel
@{
    ViewData["Title"] = "Withdrawal processing and balance deduction workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Withdrawal processing and balance deduction workflow">
    <h1>Withdrawal processing and balance deduction workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmwithdraw</code>.</p>
    

    <form method="post">
        <div class="ui-scaffold-field" data-field-id="txtdateoftransaction">
            <label for="txtdateoftransaction">Date Of Transaction</label>
            <input type="date" id="txtdateoftransaction" name="txtdateoftransaction" placeholder="Optional date of transaction" value="@Model.State.GetValueOrDefault("txtdateoftransaction", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtdateoftransaction"))
            {
                <span data-error-for="txtdateoftransaction">@Model.Errors["txtdateoftransaction"]</span>
            }
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="frame1">
            <legend>Group 1</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame3">
            <legend>Group 3</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="fracheque">
            <legend>Cheque</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frawithdrawn">
            <legend>Withdrawn</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label2">
            <label for="label2">Label 2</label>
            <output id="label2" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label2", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfieldlabel">
            <label for="lblfieldlabel">Field Label</label>
            <output id="lblfieldlabel" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfieldlabel", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblaccountno">
            <label for="lblaccountno">Account No</label>
            <output id="lblaccountno" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblaccountno", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblaccounttype">
            <label for="lblaccounttype">Account Type</label>
            <output id="lblaccounttype" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblaccounttype", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbalance">
            <label for="lblbalance">Balance</label>
            <output id="lblbalance" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbalance", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcheque">
            <label for="lblcheque">Cheque</label>
            <output id="lblcheque" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcheque", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblchequeissued">
            <label for="lblchequeissued">Cheque Issued</label>
            <output id="lblchequeissued" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblchequeissued", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustid">
            <label for="lblcustid">Custid</label>
            <output id="lblcustid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustid", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomerid">
            <label for="lblcustomerid">Customer Id</label>
            <output id="lblcustomerid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomerid", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbldate">
            <label for="lbldate">Date</label>
            <output id="lbldate" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbldate", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfirst">
            <label for="lblfirst">First</label>
            <output id="lblfirst" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfirst", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfirstname">
            <label for="lblfirstname">First Name</label>
            <output id="lblfirstname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfirstname", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllast">
            <label for="lbllast">Last</label>
            <output id="lbllast" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllast", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllastname">
            <label for="lbllastname">Last Name</label>
            <output id="lbllastname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllastname", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbltag">
            <label for="lbltag">Tag</label>
            <output id="lbltag" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbltag", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbltypeofaccount">
            <label for="lbltypeofaccount">Type Of Account</label>
            <output id="lbltypeofaccount" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbltypeofaccount", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <fieldset class="ui-scaffold-choice" data-radio-group="yesno">
            <legend>Yes or No</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optno" name="yesno" value="No" />
                <span>No</span>
            </label>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optyes" name="yesno" value="Yes" />
                <span>Yes</span>
            </label>
        </fieldset>
        <div class="ui-scaffold-field" data-field-id="txtaccountno">
            <label for="txtaccountno">Account No</label>
            <input type="number" id="txtaccountno" name="txtaccountno" placeholder="Enter account no" value="@Model.State.GetValueOrDefault("txtaccountno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtaccountno"))
            {
                <span data-error-for="txtaccountno">@Model.Errors["txtaccountno"]</span>
            }
            <p class="ui-scaffold-hint">Txtaccountno is required.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txttransactionid">
            <label for="txttransactionid">Transaction Id</label>
            <input type="number" id="txttransactionid" name="txttransactionid" placeholder="Optional transaction id" value="@Model.State.GetValueOrDefault("txttransactionid", string.Empty)" />
            @if (Model.Errors.ContainsKey("txttransactionid"))
            {
                <span data-error-for="txttransactionid">@Model.Errors["txttransactionid"]</span>
            }
            <p class="ui-scaffold-hint">Txttransactionid must be numeric.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtwithdrawn">
            <label for="txtwithdrawn">Withdrawn</label>
            <input type="text" id="txtwithdrawn" name="txtwithdrawn" placeholder="Optional withdrawn" value="@Model.State.GetValueOrDefault("txtwithdrawn", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtwithdrawn"))
            {
                <span data-error-for="txtwithdrawn">@Model.Errors["txtwithdrawn"]</span>
            }
            
        </div>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtCancel">Cancel</button>
        </div>
    </form>
</main>
