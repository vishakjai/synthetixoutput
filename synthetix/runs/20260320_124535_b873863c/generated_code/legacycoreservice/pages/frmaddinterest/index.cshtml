@page "/ui/frmaddinterest"
@model LegacyCoreService.Pages.Frmaddinterest.IndexModel
@{
    ViewData["Title"] = "Interest calculation and posting workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Interest calculation and posting workflow">
    <h1>Interest calculation and posting workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmaddinterest</code>.</p>
    

    <form method="post">
        <div class="ui-scaffold-field" data-field-id="txtdate">
            <label for="txtdate">Date</label>
            <input type="date" id="txtdate" name="txtdate" placeholder="Optional date" value="@Model.State.GetValueOrDefault("txtdate", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtdate"))
            {
                <span data-error-for="txtdate">@Model.Errors["txtdate"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="cbomonth">
            <label for="cbomonth">Month</label>
            <select id="cbomonth" name="cbomonth">
                <option value="Select an option">Select an option</option>
            </select>
            
        </div>
        <div class="ui-scaffold-field" data-field-id="cboyear">
            <label for="cboyear">Year</label>
            <select id="cboyear" name="cboyear">
                <option value="Select an option">Select an option</option>
            </select>
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="frame1">
            <legend>Group 1</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame2">
            <legend>Group 2</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="fra">
            <legend>Fra</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label1">
            <label for="label1">Label 1</label>
            <output id="label1" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label1", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label5">
            <label for="label5">Label 5</label>
            <output id="label5" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label5", "Pending lookup")</output>
