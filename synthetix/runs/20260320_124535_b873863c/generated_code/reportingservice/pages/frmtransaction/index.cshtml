@page "/ui/frmtransaction"
@model ReportingService.Pages.Frmtransaction.IndexModel
@{
    ViewData["Title"] = "Transaction ledger management and adjustment workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Transaction ledger management and adjustment workflow">
    <h1>Transaction ledger management and adjustment workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmtransaction</code>.</p>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="lvwtransactions">
            <label for="lvwtransactions">Lvw Transactions</label>
            <input type="text" id="lvwtransactions" name="lvwtransactions" placeholder="Optional lvw transactions" value="@Model.State.GetValueOrDefault("lvwtransactions", string.Empty)" />
            @if (Model.Errors.ContainsKey("lvwtransactions"))
            {
                <span data-error-for="lvwtransactions">@Model.Errors["lvwtransactions"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="cboaccno">
            <label for="cboaccno">Acc No</label>
            <select id="cboaccno" name="cboaccno">
                <option value="Select an option">Select an option</option>
            </select>
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="frame1">
            <legend>Group 1</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame3">
            <legend>Group 3</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="fraaccountno">
            <legend>Accountno</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label2">
            <label for="label2">Label 2</label>
            <output id="label2" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label2", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label5">
            <label for="label5">Label 5</label>
            <output id="label5" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label5", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <fieldset class="ui-scaffold-choice" data-field-id="option1">
            <legend>Ion1</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="option1" name="option1" value="Ion1" />
                <span>Ion1</span>
            </label>
        </fieldset>
        <fieldset class="ui-scaffold-choice" data-field-id="option2">
            <legend>Ion2</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="option2" name="option2" value="Ion2" />
                <span>Ion2</span>
            </label>
        </fieldset>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtSave">Save</button>
        </div>
    </form>
</main>
