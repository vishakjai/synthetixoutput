@page "/ui/frmdeposit"
@model TransactionService.Pages.Frmdeposit.IndexModel
@{
    ViewData["Title"] = "Deposit capture and balance posting workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Deposit capture and balance posting workflow">
    <h1>Deposit capture and balance posting workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmdeposit</code>.</p>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="txtdateoftransaction">
            <label for="txtdateoftransaction">Dateoftransaction</label>
            <input type="date" id="txtdateoftransaction" name="txtdateoftransaction" placeholder="Optional dateoftransaction" value="@Model.State.GetValueOrDefault("txtdateoftransaction", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtdateoftransaction"))
            {
                <span data-error-for="txtdateoftransaction">@Model.Errors["txtdateoftransaction"]</span>
            }
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="frame1">
            <legend>Group 1</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame2">
            <legend>Group 2</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame3">
            <legend>Group 3</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="fracheque">
            <legend>Cheque</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="fraext">
            <legend>Ext</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="framode">
            <legend>Mode</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label2">
            <label for="label2">Label 2</label>
            <output id="label2" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label2", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfieldlabel">
            <label for="lblfieldlabel">Field Label</label>
            <output id="lblfieldlabel" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfieldlabel", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblaccount">
            <label for="lblaccount">Account</label>
            <output id="lblaccount" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblaccount", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbalance">
            <label for="lblbalance">Balance</label>
            <output id="lblbalance" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbalance", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbankname">
            <label for="lblbankname">Bankname</label>
            <output id="lblbankname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbankname", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblchequeissued">
            <label for="lblchequeissued">Chequeissued</label>
            <output id="lblchequeissued" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblchequeissued", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomer">
            <label for="lblcustomer">Customer</label>
            <output id="lblcustomer" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomer", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomerid">
            <label for="lblcustomerid">Customerid</label>
            <output id="lblcustomerid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomerid", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbldate">
            <label for="lbldate">Date</label>
            <output id="lbldate" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbldate", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfirst">
            <label for="lblfirst">First</label>
            <output id="lblfirst" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfirst", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfirstname">
            <label for="lblfirstname">Firstname</label>
            <output id="lblfirstname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfirstname", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllast">
            <label for="lbllast">Last</label>
            <output id="lbllast" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllast", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllastname">
            <label for="lbllastname">Lastname</label>
            <output id="lbllastname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllastname", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbltypeofaccount">
            <label for="lbltypeofaccount">Typeofaccount</label>
            <output id="lbltypeofaccount" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbltypeofaccount", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <fieldset class="ui-scaffold-choice" data-field-id="optcash">
            <legend>Cash</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optcash" name="paymentmode" value="Cash" />
                <span>Cash</span>
            </label>
        </fieldset>
        <fieldset class="ui-scaffold-choice" data-field-id="optcheque">
            <legend>Cheque</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optcheque" name="paymentmode" value="Cheque" />
                <span>Cheque</span>
            </label>
        </fieldset>
        <fieldset class="ui-scaffold-choice" data-field-id="optno">
            <legend>No</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optno" name="yesno" value="No" />
                <span>No</span>
            </label>
        </fieldset>
        <fieldset class="ui-scaffold-choice" data-field-id="optyes">
            <legend>Yes</legend>
            <label class="ui-scaffold-choice-option">
                <input type="radio" id="optyes" name="yesno" value="Yes" />
                <span>Yes</span>
            </label>
        </fieldset>
        <div class="ui-scaffold-field" data-field-id="txtbankname">
            <label for="txtbankname">Bankname</label>
            <input type="text" id="txtbankname" name="txtbankname" placeholder="Enter bankname" value="@Model.State.GetValueOrDefault("txtbankname", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtbankname"))
            {
                <span data-error-for="txtbankname">@Model.Errors["txtbankname"]</span>
            }
            <p class="ui-scaffold-hint">Txtbankname is required.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtchequeno">
            <label for="txtchequeno">Chequeno</label>
            <input type="text" id="txtchequeno" name="txtchequeno" placeholder="Optional chequeno" value="@Model.State.GetValueOrDefault("txtchequeno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtchequeno"))
            {
                <span data-error-for="txtchequeno">@Model.Errors["txtchequeno"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txtsearchaccountno">
            <label for="txtsearchaccountno">Searchaccountno</label>
            <input type="number" id="txtsearchaccountno" name="txtsearchaccountno" placeholder="Enter searchaccountno" value="@Model.State.GetValueOrDefault("txtsearchaccountno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtsearchaccountno"))
            {
                <span data-error-for="txtsearchaccountno">@Model.Errors["txtsearchaccountno"]</span>
            }
            <p class="ui-scaffold-hint">Txtsearchaccountno is required.</p>
        </div>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtSave">Save</button>
        <button type="submit" formaction="?handler=EvtCancel">Cancel</button>
        </div>
    </form>
</main>
