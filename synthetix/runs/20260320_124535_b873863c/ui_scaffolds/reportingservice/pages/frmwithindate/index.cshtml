@page "/ui/frmwithindate"
@model ReportingService.Pages.FrmWithinDate.IndexModel
@{
    ViewData["Title"] = "Business workflow executed through event-driven UI controls";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Business workflow executed through event-driven UI controls">
    <h1>Business workflow executed through event-driven UI controls</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmWithinDate</code>.</p>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="dtfrom">
            <label for="dtfrom">D T From</label>
            <input type="text" id="dtfrom" name="dtfrom" placeholder="Optional d t from" value="@Model.State.GetValueOrDefault("dtfrom", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtfrom"))
            {
                <span data-error-for="dtfrom">@Model.Errors["dtfrom"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="dtto">
            <label for="dtto">D T To</label>
            <input type="text" id="dtto" name="dtto" placeholder="Optional d t to" value="@Model.State.GetValueOrDefault("dtto", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtto"))
            {
                <span data-error-for="dtto">@Model.Errors["dtto"]</span>
            }
            
        </div>
        <fieldset class="ui-scaffold-group" data-field-id="frame1">
            <legend>Group 1</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frame2">
            <legend>Group 2</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <fieldset class="ui-scaffold-group" data-field-id="frawithindate">
            <legend>Withindate</legend>
            <p class="ui-scaffold-hint">Legacy grouping container preserved for behavioral structure.</p>
        </fieldset>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label1">
            <label for="label1">Label 1</label>
            <output id="label1" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label1", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="label2">
            <label for="label2">Label 2</label>
            <output id="label2" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("label2", "Pending lookup")</output>
            <p class="ui-scaffold-hint">Legacy display-only value.</p>
        </div>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtCancel">Cancel</button>
        </div>
    </form>
</main>
