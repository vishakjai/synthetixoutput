@page "/ui/frmmonthly"
@model ReportingService.Pages.FrmMonthly.IndexModel
@{
    ViewData["Title"] = "Operational reporting and statement generation workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Operational reporting and statement generation workflow">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmMonthly</p>
        <h1>Operational reporting and statement generation workflow</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmMonthly</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="cmbreport">
            <label for="cmbreport">Report</label>
            <select id="cmbreport" name="cmbreport">
                <option value="Select an option">Select an option</option>
            </select>
            
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-primary" type="submit" formaction="?handler=EvtSave"><span>Save</span><small>POST /reporting/expireitemswithindate, list</small></button>
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
