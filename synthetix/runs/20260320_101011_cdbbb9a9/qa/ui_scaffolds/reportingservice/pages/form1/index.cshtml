@page "/ui/form1"
@model ReportingService.Pages.Form1.IndexModel
@{
    ViewData["Title"] = "Business workflow executed through event-driven UI controls";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Business workflow executed through event-driven UI controls">
    <header class="screen-header">
        <p class="meta-chip">Contract: Form1</p>
        <h1>Business workflow executed through event-driven UI controls</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>Form1</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="dtpicker1">
        <label for="dtpicker1">D T Picker1</label>
        <input type="text" id="dtpicker1" name="dtpicker1" placeholder="Optional d t picker1" value="@Model.State.GetValueOrDefault("dtpicker1", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpicker1"))
            {
                <span data-error-for="dtpicker1">@Model.Errors["dtpicker1"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="dtpicker2">
        <label for="dtpicker2">D T Picker2</label>
        <input type="text" id="dtpicker2" name="dtpicker2" placeholder="Optional d t picker2" value="@Model.State.GetValueOrDefault("dtpicker2", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpicker2"))
            {
                <span data-error-for="dtpicker2">@Model.Errors["dtpicker2"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="shape5">
        <label for="shape5">Shape5</label>
        <input type="text" id="shape5" name="shape5" placeholder="Optional shape5" value="@Model.State.GetValueOrDefault("shape5", string.Empty)" />
            @if (Model.Errors.ContainsKey("shape5"))
            {
                <span data-error-for="shape5">@Model.Errors["shape5"]</span>
            }
            
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-primary" type="submit" formaction="?handler=EvtSave"><span>Save</span><small>POST /reporting/expireitemswithindate, list</small></button>
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
