@page "/ui/frmcheckbalance"
@model TransactionService.Pages.Frmcheckbalance.IndexModel
@{
    ViewData["Title"] = "Balance inquiry and reconciliation workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Balance inquiry and reconciliation workflow">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmcheckbalance</p>
        <h1>Balance inquiry and reconciliation workflow</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmcheckbalance</code>.</p>
    </header>
    
    <form method="post">
        <div class="ui-scaffold-field" data-field-id="dtpicker1">
        <label for="dtpicker1">D T Picker1</label>
        <input type="text" id="dtpicker1" name="dtpicker1" placeholder="Optional d t picker1" value="@Model.State.GetValueOrDefault("dtpicker1", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpicker1"))
            {
                <span data-error-for="dtpicker1">@Model.Errors["dtpicker1"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="cboaccountno">
            <label for="cboaccountno">Account No</label>
            <select id="cboaccountno" name="cboaccountno">
                <option value="Yes">Yes</option>
                <option value="No">No</option>
            </select>
            <p class="ui-scaffold-hint">Enter digits only.</p>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblaccno">
            <label for="lblaccno">Ac Cno</label>
            <output id="lblaccno" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblaccno", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblaccountno">
            <label for="lblaccountno">Account No</label>
            <output id="lblaccountno" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblaccountno", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbal">
            <label for="lblbal">Bal</label>
            <output id="lblbal" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbal", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblbalance">
            <label for="lblbalance">Balance</label>
            <output id="lblbalance" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblbalance", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcontacttitle">
            <label for="lblcontacttitle">Con Tac Tti Tle</label>
            <output id="lblcontacttitle" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcontacttitle", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblcustomerid">
            <label for="lblcustomerid">Customer ID</label>
            <output id="lblcustomerid" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblcustomerid", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbldate">
            <label for="lbldate">Date</label>
            <output id="lbldate" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbldate", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lblfirstname">
            <label for="lblfirstname">First Name</label>
            <output id="lblfirstname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lblfirstname", "—")</output>
        </div>
        <div class="ui-scaffold-field ui-scaffold-display" data-field-id="lbllastname">
            <label for="lbllastname">Last Name</label>
            <output id="lbllastname" aria-live="polite">@Model.DisplayValues.GetValueOrDefault("lbllastname", "—")</output>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtacno">
        <label for="txtacno">A Cno</label>
        <input type="text" id="txtacno" name="txtacno" placeholder="Optional a cno" value="@Model.State.GetValueOrDefault("txtacno", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtacno"))
            {
                <span data-error-for="txtacno">@Model.Errors["txtacno"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txtcontacttitle">
        <label for="txtcontacttitle">Con Tac Tti Tle</label>
        <input type="text" id="txtcontacttitle" name="txtcontacttitle" placeholder="Optional con tac tti tle" value="@Model.State.GetValueOrDefault("txtcontacttitle", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtcontacttitle"))
            {
                <span data-error-for="txtcontacttitle">@Model.Errors["txtcontacttitle"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txtcustomerid">
        <label for="txtcustomerid">Customer ID</label>
        <input type="number" id="txtcustomerid" name="txtcustomerid" placeholder="Enter customer id" value="@Model.State.GetValueOrDefault("txtcustomerid", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtcustomerid"))
            {
                <span data-error-for="txtcustomerid">@Model.Errors["txtcustomerid"]</span>
            }
            <p class="ui-scaffold-hint">Enter digits only.</p>
        </div>
        <div class="ui-scaffold-field" data-field-id="txtfirstname">
        <label for="txtfirstname">First Name</label>
        <input type="text" id="txtfirstname" name="txtfirstname" placeholder="Enter first name" value="@Model.State.GetValueOrDefault("txtfirstname", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtfirstname"))
            {
                <span data-error-for="txtfirstname">@Model.Errors["txtfirstname"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txtlastname">
        <label for="txtlastname">Last Name</label>
        <input type="text" id="txtlastname" name="txtlastname" placeholder="Enter last name" value="@Model.State.GetValueOrDefault("txtlastname", string.Empty)" />
            @if (Model.Errors.ContainsKey("txtlastname"))
            {
                <span data-error-for="txtlastname">@Model.Errors["txtlastname"]</span>
            }
            
        </div>
        <div class="ui-scaffold-field" data-field-id="txttypeofaccount">
        <label for="txttypeofaccount">Type Of Account</label>
        <input type="number" id="txttypeofaccount" name="txttypeofaccount" placeholder="Enter type of account" value="@Model.State.GetValueOrDefault("txttypeofaccount", string.Empty)" />
            @if (Model.Errors.ContainsKey("txttypeofaccount"))
            {
                <span data-error-for="txttypeofaccount">@Model.Errors["txttypeofaccount"]</span>
            }
            <p class="ui-scaffold-hint">Enter digits only.</p>
        </div>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-primary" type="submit" formaction="?handler=EvtSave"><span>Save</span><small>POST /transactions/deposit, list</small></button>
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
