@page "/ui/frmmonthlyreport"
@model ReportingService.Pages.Frmmonthlyreport.IndexModel
@{
    ViewData["Title"] = "Operational reporting and statement generation workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Operational reporting and statement generation workflow">
    <h1>Operational reporting and statement generation workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmmonthlyreport</code>.</p>
    <form method="post">
        <div class="ui-scaffold-field">
            <label for="dtpfrom">D T P From</label>
            <input id="dtpfrom" name="dtpfrom" value="@Model.State.GetValueOrDefault("dtpfrom", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpfrom"))
            {
                <span data-error-for="dtpfrom">@Model.Errors["dtpfrom"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="dtpto">D T P To</label>
            <input id="dtpto" name="dtpto" value="@Model.State.GetValueOrDefault("dtpto", string.Empty)" />
            @if (Model.Errors.ContainsKey("dtpto"))
            {
                <span data-error-for="dtpto">@Model.Errors["dtpto"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="cmbcustomerid">Cmbcustomerid</label>
            <input id="cmbcustomerid" name="cmbcustomerid" value="@Model.State.GetValueOrDefault("cmbcustomerid", string.Empty)" />
            @if (Model.Errors.ContainsKey("cmbcustomerid"))
            {
                <span data-error-for="cmbcustomerid">@Model.Errors["cmbcustomerid"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="frame1">Frame1</label>
            <input id="frame1" name="frame1" value="@Model.State.GetValueOrDefault("frame1", string.Empty)" />
            @if (Model.Errors.ContainsKey("frame1"))
            {
                <span data-error-for="frame1">@Model.Errors["frame1"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="label1">Label1</label>
            <input id="label1" name="label1" value="@Model.State.GetValueOrDefault("label1", string.Empty)" />
            @if (Model.Errors.ContainsKey("label1"))
            {
                <span data-error-for="label1">@Model.Errors["label1"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="lblfrom">Lbl From</label>
            <input id="lblfrom" name="lblfrom" value="@Model.State.GetValueOrDefault("lblfrom", string.Empty)" />
            @if (Model.Errors.ContainsKey("lblfrom"))
            {
                <span data-error-for="lblfrom">@Model.Errors["lblfrom"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="lblto">Lbl To</label>
            <input id="lblto" name="lblto" value="@Model.State.GetValueOrDefault("lblto", string.Empty)" />
            @if (Model.Errors.ContainsKey("lblto"))
            {
                <span data-error-for="lblto">@Model.Errors["lblto"]</span>
            }
        </div>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtCancel">Cancel</button>
        </div>
    </form>
</main>
