@page "/ui/frmtransaction"
@model ReportingService.Pages.Frmtransaction.IndexModel
@{
    ViewData["Title"] = "Transaction ledger management and adjustment workflow";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<main aria-label="Transaction ledger management and adjustment workflow">
    <h1>Transaction ledger management and adjustment workflow</h1>
    <p>Behavioral scaffold derived from Screen Contract <code>frmtransaction</code>.</p>
    <form method="post">
        <div class="ui-scaffold-field">
            <label for="lvwtransactions">Lvw Transactions</label>
            <input id="lvwtransactions" name="lvwtransactions" value="@Model.State.GetValueOrDefault("lvwtransactions", string.Empty)" />
            @if (Model.Errors.ContainsKey("lvwtransactions"))
            {
                <span data-error-for="lvwtransactions">@Model.Errors["lvwtransactions"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="cboaccno">Cbo Acc No</label>
            <input id="cboaccno" name="cboaccno" value="@Model.State.GetValueOrDefault("cboaccno", string.Empty)" />
            @if (Model.Errors.ContainsKey("cboaccno"))
            {
                <span data-error-for="cboaccno">@Model.Errors["cboaccno"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="frame1">Frame1</label>
            <input id="frame1" name="frame1" value="@Model.State.GetValueOrDefault("frame1", string.Empty)" />
            @if (Model.Errors.ContainsKey("frame1"))
            {
                <span data-error-for="frame1">@Model.Errors["frame1"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="frame3">Frame3</label>
            <input id="frame3" name="frame3" value="@Model.State.GetValueOrDefault("frame3", string.Empty)" />
            @if (Model.Errors.ContainsKey("frame3"))
            {
                <span data-error-for="frame3">@Model.Errors["frame3"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="fraaccountno">Fraaccountno</label>
            <input id="fraaccountno" name="fraaccountno" value="@Model.State.GetValueOrDefault("fraaccountno", string.Empty)" />
            @if (Model.Errors.ContainsKey("fraaccountno"))
            {
                <span data-error-for="fraaccountno">@Model.Errors["fraaccountno"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="label2">Label2</label>
            <input id="label2" name="label2" value="@Model.State.GetValueOrDefault("label2", string.Empty)" />
            @if (Model.Errors.ContainsKey("label2"))
            {
                <span data-error-for="label2">@Model.Errors["label2"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="label5">Label5</label>
            <input id="label5" name="label5" value="@Model.State.GetValueOrDefault("label5", string.Empty)" />
            @if (Model.Errors.ContainsKey("label5"))
            {
                <span data-error-for="label5">@Model.Errors["label5"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="option1">Option1</label>
            <input id="option1" name="option1" value="@Model.State.GetValueOrDefault("option1", string.Empty)" />
            @if (Model.Errors.ContainsKey("option1"))
            {
                <span data-error-for="option1">@Model.Errors["option1"]</span>
            }
        </div>
        <div class="ui-scaffold-field">
            <label for="option2">Option2</label>
            <input id="option2" name="option2" value="@Model.State.GetValueOrDefault("option2", string.Empty)" />
            @if (Model.Errors.ContainsKey("option2"))
            {
                <span data-error-for="option2">@Model.Errors["option2"]</span>
            }
        </div>
        <div class="ui-scaffold-actions">
        <button type="submit" formaction="?handler=EvtSave">Save</button>
        </div>
    </form>
</main>
