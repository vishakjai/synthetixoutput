@page "/ui/frmdep"
@model LegacyCoreService.Pages.Frmdep.IndexModel
@{
    ViewData["Title"] = "Business workflow executed through event-driven UI controls";
}
<!-- UI_SCAFFOLD: Visual design intentionally out of scope. -->
<head>
    <link rel="stylesheet" href="/css/render-profile.enterprise-neutral.preload.css" />
</head>
<main class="screen-shell" aria-label="Business workflow executed through event-driven UI controls">
    <header class="screen-header">
        <p class="meta-chip">Contract: frmdep</p>
        <h1>Business workflow executed through event-driven UI controls</h1>
        <p>Behavioral scaffold derived from Screen Contract <code>frmdep</code>.</p>
    </header>
    
    <form method="post">
        <p>No fields defined in the Screen Contract.</p>
        <nav class="action-bar" aria-label="Screen actions">
        <button class="action-button action-button-primary" type="submit" formaction="?handler=EvtSave"><span>Save</span><small>POST /legacycore/addinterest, list</small></button>
        <button class="action-button action-button-secondary" type="submit" formaction="?handler=EvtCancel"><span>Cancel</span><small>previous</small></button>
        </nav>
    </form>
</main>
